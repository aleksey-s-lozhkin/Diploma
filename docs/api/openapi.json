{
  "openapi": "3.0.3",
  "info": {
    "title": "DocSearch API",
    "description": "API для полнотекстового поиска по документам с JWT-аутентификацией",
    "version": "1.0.0",
    "contact": {
      "name": "Aleksey Lozhkin",
      "email": "aleksey.s.lozhkin@gmail.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "Локальный сервер разработки"
    },
    {
      "url": "https://your-domain.com",
      "description": "Production сервер"
    }
  ],
  "tags": [
    { "name": "auth", "description": "Аутентификация и JWT токены" },
    { "name": "users", "description": "Управление пользователями" },
    { "name": "documents", "description": "CRUD операции с документами" },
    { "name": "search", "description": "Поиск и история" }
  ],
  "paths": {
    "/api/user/register/": {
      "post": {
        "operationId": "user_register",
        "summary": "Регистрация пользователя",
        "description": "Создаёт нового пользователя и отправляет письмо с подтверждением email",
        "tags": ["users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "password2"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "user@example.com" },
                  "password": { "type": "string", "format": "password", "minLength": 8 },
                  "password2": { "type": "string", "format": "password" },
                  "first_name": { "type": "string", "maxLength": 30 },
                  "last_name": { "type": "string", "maxLength": 30 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" },
                    "access": { "type": "string" },
                    "refresh": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Ошибка валидации" },
          "429": { "description": "Слишком много попыток (3 в час)" }
        }
      }
    },
    "/api/user/login/": {
      "post": {
        "operationId": "user_login",
        "summary": "Вход пользователя",
        "description": "Аутентификация по email и паролю. Возвращает JWT токены.",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешный вход",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access": { "type": "string" },
                    "refresh": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Неверные учётные данные или email не подтверждён" },
          "429": { "description": "Слишком много попыток (10 за 5 минут)" }
        }
      }
    },
    "/api/user/logout/": {
      "post": {
        "operationId": "user_logout",
        "summary": "Выход из системы",
        "description": "Добавляет refresh токен в черный список",
        "tags": ["auth"],
        "security": [{ "jwtAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh"],
                "properties": { "refresh": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "205": { "description": "Успешный выход" },
          "400": { "description": "Невалидный токен" }
        }
      }
    },
    "/api/user/refresh/": {
      "post": {
        "operationId": "token_refresh",
        "summary": "Обновление access токена",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh"],
                "properties": { "refresh": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новый access токен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "access": { "type": "string" } }
                }
              }
            }
          },
          "401": { "description": "Невалидный refresh токен" }
        }
      }
    },
    "/api/user/verify/": {
      "post": {
        "operationId": "token_verify",
        "summary": "Проверка токена",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": { "token": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Токен валиден" },
          "401": { "description": "Токен не валиден" }
        }
      }
    },
    "/api/user/profile/": {
      "get": {
        "operationId": "user_profile",
        "summary": "Профиль пользователя",
        "tags": ["users"],
        "security": [{ "jwtAuth": [] }],
        "responses": {
          "200": {
            "description": "Данные профиля",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "Не авторизован" },
          "429": { "description": "Слишком много запросов (100 в минуту)" }
        }
      }
    },
    "/api/documents/": {
      "get": {
        "operationId": "documents_list",
        "summary": "Список документов",
        "description": "Возвращает список документов текущего пользователя с пагинацией",
        "tags": ["documents"],
        "security": [{ "jwtAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 10, "maximum": 100 } }
        ],
        "responses": {
          "200": {
            "description": "Список документов",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedDocumentList" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "documents_create",
        "summary": "Создание документа",
        "description": "Создаёт новый документ из текста или загруженного файла",
        "tags": ["documents"],
        "security": [{ "jwtAuth": [] }],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "rubrics": { "type": "string", "description": "Рубрики через запятую", "example": "технологии, python, django" },
                  "text": { "type": "string", "description": "Текст документа" },
                  "is_public": { "type": "boolean", "default": false },
                  "file": { "type": "string", "format": "binary", "description": "Файл (PDF, DOCX, XLSX, TXT)" }
                }
              }
            },
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DocumentCreateUpdate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Документ создан",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Document" } } }
          },
          "400": { "description": "Ошибка валидации" }
        }
      }
    },
    "/api/documents/{id}/": {
      "get": {
        "operationId": "documents_retrieve",
        "summary": "Получение документа",
        "tags": ["documents"],
        "security": [{ "jwtAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Document" } } } },
          "403": { "description": "Нет доступа к документу" },
          "404": { "description": "Документ не найден" }
        }
      },
      "put": {
        "operationId": "documents_update",
        "summary": "Полное обновление документа",
        "tags": ["documents"],
        "security": [{ "jwtAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DocumentCreateUpdate" } } }
        },
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Document" } } } }
        }
      },
      "patch": {
        "operationId": "documents_partial_update",
        "summary": "Частичное обновление",
        "tags": ["documents"],
        "security": [{ "jwtAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PatchedDocumentCreateUpdate" } } }
        },
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Document" } } } }
        }
      },
      "delete": {
        "operationId": "documents_destroy",
        "summary": "Удаление документа",
        "tags": ["documents"],
        "security": [{ "jwtAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "204": { "description": "Документ удалён" },
          "403": { "description": "Нет прав на удаление" },
          "404": { "description": "Документ не найден" }
        }
      }
    },
    "/api/search/": {
      "post": {
        "operationId": "search",
        "summary": "Поиск документов",
        "description": "Полнотекстовый поиск с фильтрацией и подсветкой результатов",
        "tags": ["search"],
        "security": [{ "jwtAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query"],
                "properties": {
                  "query": { "type": "string", "description": "Поисковый запрос", "example": "python разработка" },
                  "rubric": { "type": "string", "description": "Фильтр по рубрике" },
                  "privacy": { "type": "string", "enum": ["all", "public", "private"], "default": "all" },
                  "page": { "type": "integer", "default": 1, "minimum": 1 },
                  "sort": { "type": "string", "enum": ["relevance", "date", "date_asc"], "default": "relevance" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результаты поиска",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResponse" } } }
          },
          "400": { "description": "Query parameter 'query' required" },
          "429": { "description": "Слишком много запросов (30 в минуту)" }
        }
      }
    },
    "/api/rubrics/": {
      "get": {
        "operationId": "rubrics_list",
        "summary": "Список рубрик",
        "description": "Возвращает уникальные рубрики из доступных пользователю документов",
        "tags": ["search"],
        "security": [{ "jwtAuth": [] }],
        "responses": {
          "200": {
            "description": "Список рубрик",
            "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } }
          }
        }
      }
    },
    "/api/search/history/{id}/": {
      "delete": {
        "operationId": "search_history_delete",
        "summary": "Удаление из истории",
        "tags": ["search"],
        "security": [{ "jwtAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "204": { "description": "Запись удалена" },
          "404": { "description": "Запись не найдена" }
        }
      }
    },
    "/health/": {
      "get": {
        "operationId": "health_check",
        "summary": "Health check",
        "description": "Проверка состояния PostgreSQL и Elasticsearch",
        "tags": ["monitoring"],
        "responses": {
          "200": {
            "description": "Все сервисы работают",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ok", "warning"] },
                    "database": { "type": "string" },
                    "elasticsearch": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "email": { "type": "string", "format": "email" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "full_name": { "type": "string", "readOnly": true },
          "date_joined": { "type": "string", "format": "date-time", "readOnly": true },
          "is_moderator": { "type": "boolean", "readOnly": true }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "rubrics": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string" },
          "created_date": { "type": "string", "format": "date-time", "readOnly": true },
          "is_public": { "type": "boolean" },
          "user_email": { "type": "string", "format": "email", "readOnly": true },
          "user_id": { "type": "integer", "readOnly": true }
        }
      },
      "DocumentCreateUpdate": {
        "type": "object",
        "properties": {
          "rubrics": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
          "text": { "type": "string" },
          "is_public": { "type": "boolean", "default": false }
        }
      },
      "PatchedDocumentCreateUpdate": {
        "type": "object",
        "properties": {
          "rubrics": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string" },
          "is_public": { "type": "boolean" }
        }
      },
      "PaginatedDocumentList": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "next": { "type": "string", "nullable": true },
          "previous": { "type": "string", "nullable": true },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/Document" } }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "rubrics": { "type": "array", "items": { "type": "string" } },
          "text": { "type": "string" },
          "created_date": { "type": "string" },
          "is_public": { "type": "boolean" },
          "highlights": { "type": "array", "items": { "type": "string" } }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "count": { "type": "integer" },
          "results": { "type": "array", "items": { "$ref": "#/components/schemas/SearchResult" } },
          "page": { "type": "integer" },
          "total_pages": { "type": "integer" },
          "page_size": { "type": "integer" }
        }
      }
    },
    "securitySchemes": {
      "jwtAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT токен, полученный при авторизации"
      }
    }
  }
}
