# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=pyconstrictor.ru,www.pyconstrictor.ru,95.54.44.225
CSRF_TRUSTED_ORIGINS=https://pyconstrictor.ru,https://www.pyconstrictor.ru,http://95.54.44.225

# PostgreSQL (на хосте)
POSTGRES_DB=docsearch
POSTGRES_USER=docsearch_user
POSTGRES_PASSWORD=your-db-password
DB_HOST=host.docker.internal  # <-- важно! Django в контейнере, БД на хосте
DB_PORT=5432

# Elasticsearch (на хосте, если используется)
ELASTICSEARCH_HOST=host.docker.internal
ELASTICSEARCH_PORT=9200

# Redis (на хосте)
REDIS_URL=redis://host.docker.internal:6379/0

# Email
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@yandex.ru
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@yandex.ru

# Docker Hub (для CI/CD)
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE=yourusername/docsearch
